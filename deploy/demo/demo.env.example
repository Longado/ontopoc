# Copy to demo.env (never commit demo.env) and fill in.
ONTOPOC_DOMAIN=demo.example.com
# A key made only for the demo, with a monthly spending limit set at the provider.
OPENROUTER_API_KEY=
# Guards for a public site (defaults shown).
ONTOPOC_DEMO_DAILY_ASKS=200
ONTOPOC_DEMO_MAX_GUESTS=300
# Where "Request access" and "Send feedback" lead.
ONTOPOC_FEEDBACK_URL=https://github.com/Longado/ontopoc/issues/new
